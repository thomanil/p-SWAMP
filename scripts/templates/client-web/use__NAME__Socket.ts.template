import { useCallback, useMemo } from 'react'

import type { Wire } from '@/api/wire'
import { __API_PATH_CONST__, __WS_PATH_CONST__ } from '@/lib/servers'
import { postCommand } from '@/lib/commands'
import { useServerSocket } from '@/hooks/useServerSocket'

/** What the server pushes, generated from the api contract — the model declared
 *  in app/server-python/src/__PKG__/api.py, not a hand-copy of it. */
type __NAME__Message = Wire['__NAME__State']

/** What this page works in: the client's own vocabulary, camelCase, mapped from
 *  the wire shape above. */
export type __NAME__State = { count: number }

/** Fire a command and carry on; a failure is logged and nothing else happens.
 *  A command that did not land produces no state change, which is what the user
 *  already sees. */
function fire(promise: Promise<void>): void {
  promise.catch((error) => console.error('__SLUG__ command failed', error))
}

/**
 * The __LABEL__ app: state arrives on the socket, commands go up as POSTs to
 * /api/__SLUG__.
 */
export function use__NAME__Socket() {
  const { message, status, connected } =
    useServerSocket<__NAME__Message>(__WS_PATH_CONST__)

  const state = useMemo<__NAME__State | null>(
    () => (message === null ? null : { count: message.count }),
    [message],
  )

  const bump = useCallback(
    () => fire(postCommand(`${__API_PATH_CONST__}/count/bump`)),
    [],
  )
  const reset = useCallback(
    () => fire(postCommand(`${__API_PATH_CONST__}/count/reset`)),
    [],
  )

  return { state, status, connected, bump, reset }
}
